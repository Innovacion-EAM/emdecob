# EMDECOB Web - Environment Variables
# Copy this file to .env.local and fill in the values.

# Site URL for metadata, sitemap, and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://emdecob.com

# Optional: Resend API Key for sending contact form emails.
# If not set, the form runs in local prototype mode (validates and logs only).
# RESEND_API_KEY=re_...

# Optional: Email address to send contact form submissions to.
# Defaults to company.email in src/content/site.ts (directoroperaciones@emdecob.com).
# CONTACT_TO_EMAIL=web@emdecob.com

# Optional: From email for Resend.
# CONTACT_FROM_EMAIL=EMDECOB Web <web@emdecob.com>

# Optional: Chrome/Chromium path for Puppeteer capture script.
# CHROME_PATH=/usr/bin/chromium
